# Generate once, keep stable, and do not commit the real value.
# Example: openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=

# Direct deployments must keep this at 0. Set to the exact trusted proxy count.
TRUST_PROXY_HOPS=0

# Supports the two-minute Plex PIN polling flow without weakening password login limits.
PLEX_POLL_RATE_LIMIT=75

# Optional direct HTTPS origin for media tickets when the application UI is behind a tunnel.
# Example: https://files.example.com or https://files.example.com:8443
DOWNLOAD_PUBLIC_ORIGIN=

# Optional `direct-origin` Compose profile settings for a renewable UPnP port mapping.
PORTMAP_INTERNAL_HOST=192.168.1.158
PORTMAP_INTERNAL_PORT=443
PORTMAP_EXTERNAL_PORT=8443
PORTMAP_LEASE_SECONDS=1200
PORTMAP_REFRESH_SECONDS=600

# Unraid production uses the available Intel UHD 730 through VAAPI.
FFMPEG_VIDEO_ENCODER=h264_vaapi

# Use libx264 instead for local development or hosts without Intel Quick Sync.
# FFMPEG_VIDEO_ENCODER=libx264
