# Generate once, keep stable, and do not commit the real value.
# Example: openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=

# Direct deployments must keep this at 0. Set to the exact trusted proxy count.
TRUST_PROXY_HOPS=0

# Supports the two-minute Plex PIN polling flow without weakening password login limits.
PLEX_POLL_RATE_LIMIT=75

# Unraid production uses the available Intel UHD 730 through VAAPI.
FFMPEG_VIDEO_ENCODER=h264_vaapi

# Use libx264 instead for local development or hosts without Intel Quick Sync.
# FFMPEG_VIDEO_ENCODER=libx264
